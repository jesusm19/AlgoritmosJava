package paresImpares;

import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;

public class ParesImpares {
	
	public static void main(String[] args) {
        int [] numeros = {1,2,5,3,3,6,3,6,7,2,4,8,8,4,2,3,4,54,63,46,34,12,23,3,1,3,2,3,4,3,5,2,3,3,4,5,6,7,8,9,0};
        // Definir un hash set para almacenar los números pares únicos
        Map<String, HashSet<Integer>> mapNumeros = paresImpares(numeros);
        HashSet<Integer> paresSet = mapNumeros.get("pares");
    	HashSet<Integer> imparesSet = mapNumeros.get("impares");
        System.out.println("Total de elements en la lista: " + numeros.length);
        System.out.println("Total de elementos pares: " + paresSet.size());
        System.out.println("Total de elementos impares: " + imparesSet.size());
        
        
        for (Integer integer : imparesSet) {
			System.out.println(integer);
		}
	}
        

    private static Map<String, HashSet<Integer>> paresImpares(int [] numeros){
    	HashSet<Integer> paresSet = new HashSet<>();
    	HashSet<Integer> imparesSet = new HashSet<>();
        for (int numero : numeros) {
            if(numero % 2 == 0){
                paresSet.add(numero);
            }
            if(numero % 2 != 0) imparesSet.add(numero);
        }
        Map<String, HashSet<Integer>> mapNumeros = new HashMap<>();
        mapNumeros.put("pares", paresSet);
        mapNumeros.put("impares", imparesSet);
        return mapNumeros;
    }

}
