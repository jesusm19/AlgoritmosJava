class Solution {
	public int[] twoSum(int[] nums, int target) {
		/*for (int i = 0; i < nums.length; i++) {
            for (int j = i + 1; j < nums.length; j++) {
                if (nums[i] + nums[j] == target) {
                    return new int[]{i, j};
                }
            }
        }

        return new int[]{};*/
		
		int[] indexes = new int[2];
		boolean isTarget = false;
		int a=0;
		int b=0;
		 for(int i=0; i< nums.length; i++){
		     int suma = nums[i];
		     a = i;
		     for(int j=i+1; j< nums.length; j++){
		         suma += nums[j];
		         b = j;
		         if(suma == target){
		         	isTarget = true;
		             break;
		         } 
		         

		         	suma -= nums[j];
		
		     }
		     
		     if(isTarget) break;
		     
		 }
		 indexes[0] = a;
		 indexes[1] = b;
		 return indexes;
		
    }
}


