package TwoSum;

import java.util.ArrayList;
import java.util.List;

public class TwoSum {
	
	public static void main(String []args) {
		int[] nums = {2,7,11,15};
		Solution solution = new Solution();
		
		List<Integer> array = solution.twoSum(nums, 9);
		for (Integer integer : array) {
			System.out.println(integer);
		}
		
	}
	
	


}


class Solution {
    public List<Integer> twoSum(int[] nums, int target) {
       ArrayList indices = new ArrayList<Integer>();
       boolean isTarget = false;
       int a=0;
       int b=0;
        for(int i=0; i< nums.length; i++){
            int suma = nums[i];
            a = i;
            for(int j=1; j< nums.length; j++){
                suma += nums[j];
                b = j;
                if(suma == target){
                	isTarget = true;
                    break;
                } 
                
                if(suma > target) {
                	suma -= nums[j];
                } 
            }
            
            if(isTarget) break;
            
        }
        indices.add(a);
        indices.add(b);
        return indices;
    }
}