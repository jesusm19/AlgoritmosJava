package romanos;

import java.util.HashMap;
import java.util.Map;

public class NumerosRomanos {
	
	public static void main(String [] args) {
		
		String numeroRomano = "XV";
		System.out.println(numeroRomano + " : " + romanToInt(numeroRomano));
		
	}
	
	private static int romanToInt(String s) {
		Map<Character, Integer> numerosRomanos = getNumerosRomanos();
		
		int suma = 0;
		for (int i = s.toCharArray().length; i > 0; i--) {
			
			int cantidad = numerosRomanos.get(s.toCharArray()[i]);
			suma += cantidad;
			
		}
		
		return suma;
    }
	
	private static Map<Character, Integer> getNumerosRomanos(){
		
		Map<Character, Integer> numerosRomanos = new HashMap<>();
		numerosRomanos.put('I', 1);
		numerosRomanos.put('V', 5);
		numerosRomanos.put('X', 10);
		numerosRomanos.put('L', 50);
		numerosRomanos.put('C', 100);
		numerosRomanos.put('D', 500);
		numerosRomanos.put('M', 1000);
		
		return numerosRomanos;
		
	}
	
	

}
